{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/index.csr.html",
          "/manifest.webmanifest",
          "/favicon.ico",
          "/apple-touch-icon.png",
          "/icon-192.png",
          "/icon-512.png",
          "/*.js",
          "/*.css"
        ]
      }
    },
    {
      "name": "fonts",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/fonts/*.woff2"]
      }
    },
    {
      "name": "course-content",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/punjabi/**/*.json", "/assets/hindi/**/*.json"]
      }
    }
  ]
}
